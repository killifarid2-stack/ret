{
  "name": "tkd-wab",
  "productName": "WAB-TKD",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build": "vite build && electron-builder",
    "test:e2e": "playwright test tests/e2e",
    "qa": "vitest run && playwright test tests/e2e",
    "release:check": "node scripts/release-check.mjs",
    "release:verify": "npm run release:check && npm run test && npm run build",
    "production:check": "node scripts/production-check.mjs",
    "production:manifest": "node scripts/create-production-manifest.mjs",
    "deployment:check": "node scripts/production-check.mjs && npm run release:check",
    "backup:prepare": "node scripts/create-production-manifest.mjs",
    "mat:check": "node scripts/mat-config-check.mjs",
    "production:release-check": "node scripts/production/production-release-check.mjs",
    "production:runbook": "node scripts/production/production-release-check.mjs",
    "production:asset-audit": "node scripts/production/asset-audit.mjs",
    "production:security-audit": "node scripts/production/security-audit.mjs",
    "production:dry-run": "node scripts/production/dry-run.mjs",
    "production:backup-manifest": "node scripts/production/backup-manifest.mjs",
    "production:final-check": "npm run production:check && npm run mat:check && npm run production:dry-run && npm run production:backup-manifest",
    "go-live:check": "node scripts/go-live/go-live-check.mjs",
    "go-live:plan": "node scripts/go-live/go-live-plan.mjs",
    "go-live:verify": "node scripts/go-live/go-live-verify.mjs",
    "electron": "npm run build && electron .",
    "production:final-feature-audit": "node scripts/production/final-feature-audit.mjs",
    "production:final-audit": "node scripts/production/final-production-audit.mjs",
    "production:env-check": "node scripts/production/prod-env-validate.mjs",
    "security:audit": "node scripts/production/electron-security-audit.mjs",
    "production:hardening-check": "node scripts/production/electron-security-audit.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
